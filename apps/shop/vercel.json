{
  "$schema": "https://openapi.vercel.sh/vercel.json", "framework": "vite", "installCommand": "cd ../.. && pnpm install --frozen-lockfile", "buildCommand": "cd ../.. && pnpm --filter @quincestone/shop build", "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!api/|assets/|favicon|apple-touch-icon|quincestone-).*)", "destination": "/index.html" }],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }] }]
}
