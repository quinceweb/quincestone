{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @quincestone/web build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "redirects": [
    { "source": "/account", "destination": "https://account.quincestone.com", "permanent": true },
    { "source": "/account/orders", "destination": "https://account.quincestone.com/orders", "permanent": true },
    { "source": "/account/saved", "destination": "https://account.quincestone.com/saved", "permanent": true },
    { "source": "/account/addresses", "destination": "https://account.quincestone.com/addresses", "permanent": true },
    { "source": "/account/profile", "destination": "https://account.quincestone.com/profile", "permanent": true },
    { "source": "/account/support", "destination": "https://account.quincestone.com/support", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap-canonical.xml" },
    { "source": "/((?!api/|assets/|favicon\\.ico$|favicon\\.svg$|apple-touch-icon\\.png$|site\\.webmanifest$|robots\\.txt$|sitemap\\.xml$|sitemap-canonical\\.xml$|og/).*)", "destination": "/index.html" }
  ]
}
